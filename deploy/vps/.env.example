MIXSETS_IMAGE_TAG=local
CORS_ORIGIN=https://mixsets.syco23.org,https://syco23-mixsets.vercel.app,https://syco23-mixsets-system-corrupt.vercel.app
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
DISCOGS_TOKEN=
YOUTUBE_API_KEY=

# Import control plane: dark until enabled AND curator auth is configured.
IMPORTS_ENABLED=false
# Shared secret between the catalog API and the import worker (HMAC service identity).
IMPORT_WORKER_SECRET=

# Import data plane (only used with `docker compose --profile imports up`).
IMPORT_WORKER_ID=import-worker-1
IMPORT_POLL_INTERVAL_MS=2000
IMPORT_HEARTBEAT_MS=20000
IMPORT_STORAGE_DRIVER=local
IMPORT_S3_ENDPOINT=
IMPORT_S3_BUCKET=
IMPORT_S3_ACCESS_KEY=
IMPORT_S3_SECRET_KEY=

# Administrative quotas for the first import release.
IMPORT_MAX_INPUT_BYTES=2147483648
IMPORT_MAX_OUTPUT_BYTES=1073741824
IMPORT_MAX_DURATION_MS=43200000
IMPORT_MAX_ATTEMPTS=5
IMPORT_AUTO_APPLY_THRESHOLD=80
