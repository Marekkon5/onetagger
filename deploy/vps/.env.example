MIXSETS_IMAGE_TAG=local
MIXSETS_REVISION=unknown
AUTH_MODE=on
CORS_ORIGIN=https://mixsets.syco23.org,https://syco23-mixsets.vercel.app,https://syco23-mixsets-system-corrupt.vercel.app
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
DISCOGS_TOKEN=
YOUTUBE_API_KEY=

# Use none with HTTPS when the approved frontend is on vercel.app.
CURATOR_COOKIE_SAME_SITE=lax
CURATOR_PASSWORD_HASH=

# Import control plane: dark until enabled AND curator auth is configured.
IMPORTS_ENABLED=false
# Deployment-wide rights attestation. True means the operator confirms once
# that they hold the rights to download/process provider content; per-mixset
# consent is then not requested. Set false to require an explicit basis.
IMPORT_GLOBAL_RIGHTS_CONFIRMATION=true
# Shared secret between the catalog API and the import worker (HMAC service identity).
IMPORT_WORKER_SECRET=

# Import data plane (only used with `docker compose --profile imports up`).
IMPORT_WORKER_ID=import-worker-1
IMPORT_POLL_INTERVAL_MS=2000
IMPORT_HEARTBEAT_MS=20000
IMPORT_STORAGE_DRIVER=local
IMPORT_STORAGE_LOCAL_ROOT=/app/data/imports
IMPORT_S3_ENDPOINT=
IMPORT_S3_BUCKET=
IMPORT_S3_ACCESS_KEY=
IMPORT_S3_SECRET_KEY=
IMPORT_S3_REGION=us-east-1
# Optional provider credentials for the import worker. MusicBrainz only needs
# a descriptive User-Agent; SoundCloud download_url needs the API app.
MUSICBRAINZ_USER_AGENT=syco23-mixsets/1.0 (https://mixsets.syco23.org)

# Administrative quotas for the first import release. Input is buffered in the
# API (768 MB limit); raw + normalized working copies must fit the worker's
# 1.5 GB memory and 640m /tmp tmpfs.
IMPORT_MAX_INPUT_BYTES=268435456
IMPORT_MAX_OUTPUT_BYTES=268435456
IMPORT_MAX_DURATION_MS=43200000
IMPORT_MAX_ATTEMPTS=5
IMPORT_AUTO_APPLY_THRESHOLD=80
