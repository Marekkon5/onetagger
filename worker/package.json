{
  "name": "@syco23/import-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@syco23/catalog-domain": "workspace:*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
