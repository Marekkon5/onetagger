# SYCO23 Mixsets provider configuration
PORT=8787
CORS_ORIGIN=http://localhost:5173
CATALOG_DB_PATH=./data/catalog.sqlite
CURATOR_PASSWORD_HASH=

# Official SoundCloud API OAuth token. Required for live SoundCloud discovery.
SOUNDCLOUD_ACCESS_TOKEN=

# Optional but strongly recommended for higher Discogs rate limits.
DISCOGS_TOKEN=

# Import control plane: dark until enabled AND curator auth is configured.
IMPORTS_ENABLED=false
# Shared secret between the catalog API and the import worker (HMAC service identity).
IMPORT_WORKER_SECRET=
IMPORT_STORAGE_DRIVER=local
IMPORT_STORAGE_LOCAL_ROOT=./data/imports
